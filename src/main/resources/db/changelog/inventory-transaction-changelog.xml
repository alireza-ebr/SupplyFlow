<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="004-create-inventory-transaction" author="mehdi">

        <createTable tableName="inventory_transaction">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="inventory_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="quantity" type="INTEGER">
                <constraints nullable="false"/>
            </column>

            <column name="previous_quantity" type="INTEGER">
                <constraints nullable="false"/>
            </column>

            <column name="new_quantity" type="INTEGER">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="inventory_transaction"
                baseColumnNames="inventory_id"
                constraintName="fk_inventory_transaction_inventory"
                referencedTableName="inventory"
                referencedColumnNames="id"/>

    </changeSet>

</databaseChangeLog>